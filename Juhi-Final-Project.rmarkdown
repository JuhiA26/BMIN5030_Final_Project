```{r}

table(nhanes_dataJA$RIAGENDR)
clean_NHANES <- nhanes_dataJA %>% drop_na(LUXCAPM,ALQ111)

#Heavy Chronic Drinking (NIAAA Definition) On data when drinking 1 for women 2 for men.
malenondrinkers <- subset(clean_NHANES, RIAGENDR == "Male" & ALQ130 <= 2)
femalenondrinkers <- subset(clean_NHANES, RIAGENDR == "Female" & ALQ130 <= 1)
nondrinkers<- subset(clean_NHANES, ALQ111=="No")

#all nondrinkers and no excessive drinking
nondrinkers <- rbind(nondrinkers, femalenondrinkers, malenondrinkers)
nondrinkers
table(nondrinkers$LBDHCI)

cohort<- subset(nondrinkers, LBDHCI=="Negative"|LBDHCI=="Negative Screening HCV Antibody")
cohort<- subset(nondrinkers, LBXHBC=="Negative")
table(cohort$RIAGENDR)

